@using dominio
@model Persona

@if (ViewBag.MensajeExito != null)
{
    <div class="alert alert-success">
        @ViewBag.MensajeExito
    </div>
}

@if (ViewBag.MensajeError != null)
{
    <div class="alert alert-danger">
        @ViewBag.MensajeError
    </div>
}

@if (Context.Session.GetString("PersonaRol") != null)
{
    <div class="container py-5">

        <div class="card shadow-lg border-0">

            <div class="card-body p-5">

                <div class="text-center mb-5">

                    <i class="bi bi-person-circle text-primary"
                       style="font-size:5rem;"></i>

                    <h2 class="fw-bold mt-3">
                        Mi Perfil
                    </h2>

                    <p class="text-secondary">
                        Información personal y cuentas vinculadas.
                    </p>

                </div>

                <div class="row g-4">

                    <div class="col-md-6">

                        <div class="card h-100 border-0 bg-light">

                            <div class="card-body">

                                <h5 class="fw-bold mb-4">

                                    <i class="bi bi-person-vcard me-2 text-primary"></i>

                                    Información Personal

                                </h5>

                                <p>
                                    <strong>Rol:</strong>

                                    @if (Model.Rol.ToString() == "ADMIN")
                                    {
                                        <span class="badge bg-danger">
                                            Administrador
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            Operador
                                        </span>
                                    }
                                </p>

                                <p>
                                    <strong>Nombre:</strong>
                                    @Model.Nombre
                                </p>

                                <p>
                                    <strong>Email:</strong>
                                    @Model.Email
                                </p>

                                <p>
                                    <strong>Teléfono:</strong>
                                    @Model.Telefono
                                </p>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="card h-100 border-0 bg-light">

                            <div class="card-body text-center">

                                <i class="bi bi-wallet2 text-primary"
                                   style="font-size:3rem;"></i>

                                <h4 class="fw-bold mt-3">
                                    @ViewBag.Cuentas.Count
                                </h4>

                                <p class="text-secondary">
                                    Cuentas Asociadas
                                </p>

                            </div>

                        </div>

                    </div>

                </div>

                <hr class="my-5" />

                <h4 class="fw-bold mb-4">

                    <i class="bi bi-wallet2 me-2 text-primary"></i>

                    Cuentas Asociadas

                </h4>

                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>

                            <tr>

                                <th>Código</th>
                                <th>Último Cambio de Contraseña</th>
                                <th>MultiFactor</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (Cuenta c in ViewBag.Cuentas)
                            {
                                <tr>

                                    <td>

                                        <span class="fw-semibold">
                                            #@c.CodigoAutoincremental
                                        </span>

                                    </td>

                                    <td>

                                        @c.FechaCambioPass.ToString("dd/MM/yyyy")

                                    </td>

                                    <td>

                                        @if (c.MultiFactor)
                                        {
                                            <span class="badge bg-success px-3 py-2">

                                                <i class="bi bi-shield-check me-1"></i>

                                                MFA Activo

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger px-3 py-2">

                                                <i class="bi bi-shield-x me-1"></i>

                                                MFA Desactivado

                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>
}
