
   @using dominio
   @model List<Persona> 

@if (TempData["MensajeError"] != null)
{

    <div class="alert alert-danger" role="alert">
        @TempData["MensajeError"]
    </div>
}
<div class="container py-5">

    <div class="card shadow-lg border-0 table-card">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>

                    <h2 class="fw-bold mb-1">
                        <i class="bi bi-people-fill text-primary me-2"></i>
                        Gestión de Personas
                    </h2>

                    <p class="text-secondary mb-0">
                        Administración de usuarios registrados en la plataforma.
                    </p>

                </div>

                <span class="badge bg-primary fs-6 px-3 py-2">
                    @Model.Count Personas
                </span>

            </div>


            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>

                        <tr>

                            <th>Cédula</th>
                            <th>Nombre</th>
                            <th>Email</th>
                            <th>Teléfono</th>
                            <th class="text-center">Acciones</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (Persona persona in Model)
                        {
                            <tr>

                                <td>

                                    <span class="fw-semibold">
                                        @persona.Cedula
                                    </span>

                                </td>

                                <td>
                                    @persona.Nombre
                                </td>

                                <td>
                                    @persona.Email
                                </td>

                                <td>
                                    @persona.Telefono
                                </td>

                                <td class="text-center">

                                    <a asp-controller="Cuentas"
                                       asp-action="Index"
                                       asp-route-cedula="@persona.Cedula"
                                       class="btn btn-primary btn-sm">

                                        <i class="bi bi-wallet2 me-1"></i>

                                        Cuentas

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>