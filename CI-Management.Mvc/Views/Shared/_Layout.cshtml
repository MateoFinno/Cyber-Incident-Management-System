@using dominio
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cyber Incident Management System</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Parte_2.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
    <link relonts.googleapis.com"/>
    <link relonts.gstatic.com"/>
    <link href="https://fonts.googleapis.com=Inter:wght@300;400;500;600;700;800&display=swap"/>
</head>
<body>
    <header>

        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">

            <div class="container">

                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">

                    <i class="bi bi-shield-lock-fill me-2"></i>

                    <span class="d-none d-md-inline">
                        Cyber Incident Management System
                    </span>

                    <span class="d-inline d-md-none">
                        CIMS
                    </span>

                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarMain">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse"
                     id="navbarMain">

                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                Inicio

                            </a>

                        </li>

                        @if (Context.Session.GetString("PersonaRol") == Rol.OPERADOR.ToString())
                        {
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Activo"
                                   asp-action="MisActivos">

                                    Mis Activos

                                </a>

                            </li>
                        }

                        @if (Context.Session.GetString("PersonaRol") == Rol.ADMIN.ToString())
                        {
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Personas"
                                   asp-action="Index">

                                    Personas

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Incidentes"
                                   asp-action="Index">

                                    Incidentes

                                </a>

                            </li>
                        }

                    </ul>

                    <ul class="navbar-nav ms-auto">

                        @if (Context.Session.GetString("PersonaRol") == null)
                        {
                            <li class="nav-item">
                                <a asp-controller="Login"
                                   asp-action="Index"
                                   class="nav-link">

                                    <i class="bi bi-box-arrow-in-right me-1"></i>
                                    Iniciar Sesión

                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Register"
                                   asp-action="Index"
                                   class="nav-link">

                                    <i class="bi bi-person-plus me-1"></i>
                                    Registrarse

                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">

                                <a asp-controller="Perfil"
                                   asp-action="Index"
                                   class="nav-link">

                                    <i class="bi bi-person-circle me-1"></i>
                                    Mi Perfil

                                </a>

                            </li>

                            <li class="nav-item">

                                <a asp-controller="Login"
                                   asp-action="Logout"
                                   class="nav-link text-danger">

                                    <i class="bi bi-box-arrow-right me-1"></i>
                                    Cerrar Sesión

                                </a>

                            </li>
                        }

                    </ul>


                </div>

            </div>

        </nav>

    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-light py-4 mt-5">

        <div class="container text-center">

            <h6 class="mb-2">
                Cyber Incident Management System
            </h6>

            <p class="text-light mb-0">
                Desarrollado por Mateo Finno
            </p>

        </div>

    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
