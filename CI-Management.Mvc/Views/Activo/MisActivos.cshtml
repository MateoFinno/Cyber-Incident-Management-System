@using dominio
@model List<dominio.Activo>

@{
    ViewData["Title"] = "Mis Activos";
}

<div class="container py-5">

    <div class="card shadow-lg border-0 table-card">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>

                    <h2 class="fw-bold mb-1">

                        <i class="bi bi-pc-display text-primary me-2"></i>

                        Mis Activos

                    </h2>

                    <p class="text-secondary mb-0">
                        Activos tecnológicos asignados a tu usuario.
                    </p>

                </div>

                @if (Model != null)
                {
                    <span class="badge bg-primary fs-6 px-3 py-2">
                        @Model.Count Activos
                    </span>
                }

            </div>

            @if (Model != null && Model.Count > 0)
            {
                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>

                            <tr>
                                <th>Código</th>
                                <th>Nombre</th>
                                <th>Tipo</th>
                                <th>Criticidad</th>
                                <th>Backup</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var a in Model)
                            {
                                <tr>

                                    <td>

                                        <span class="fw-semibold">
                                            #@a.CodigoAutoincremental
                                        </span>

                                    </td>

                                    <td>
                                        @a.Nombre
                                    </td>

                                    <td>

                                        <span class="badge bg-secondary">

                                            @a.TipoActivo

                                        </span>

                                    </td>

                                    <td>

                                        @if (a.Criticidad >= 4)
                                        {
                                            <span class="badge bg-danger px-3 py-2">

                                                🔴 Crítica

                                            </span>
                                        }
                                        else if (a.Criticidad >= 3)
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-2">

                                                🟠 Alta

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success px-3 py-2">

                                                🟢 Normal

                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (a.Backup)
                                        {
                                            <span class="badge bg-success px-3 py-2">

                                                <i class="bi bi-cloud-check me-1"></i>

                                                Protegido

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger px-3 py-2">

                                                <i class="bi bi-cloud-x me-1"></i>

                                                Sin Backup

                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-pc-display text-secondary"
                       style="font-size:4rem"></i>

                    <h4 class="mt-3">
                        No hay activos asignados
                    </h4>

                    <p class="text-secondary">
                        Actualmente no tenés activos vinculados a tu usuario.
                    </p>

                </div>
            }

        </div>

    </div>

</div>