@using dominio
@model Cuenta

@if (ViewBag.MensajeExito != null)
{
    <div class="alert alert-success">
        @ViewBag.MensajeExito
    </div>
}

@if (ViewBag.MensajeError != null)
{
    <div class="alert alert-danger">
        @ViewBag.MensajeError
    </div>
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-lg border-0">

                <div class="card-body p-5">

                    <div class="text-center mb-4">

                        <i class="bi bi-pc-display text-primary"
                           style="font-size:4rem;"></i>

                        <h2 class="fw-bold mt-3">
                            Asociar Activo
                        </h2>

                        <p class="text-secondary">
                            Cuenta #@Model.CodigoAutoincremental · @Model.Titular.Nombre
                        </p>

                    </div>

                    <form action="/Activo/Asociar" method="post">

                        <input type="hidden"
                               name="codigoCuenta"
                               value="@ViewBag.cuenta" />

                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Nombre del Activo
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">

                                    <i class="bi bi-tag"></i>

                                </span>

                                <input type="text"
                                       class="form-control form-control-lg"
                                       name="Nombre"
                                       placeholder="Equipo Principal"
                                       required />

                            </div>

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Tipo de Activo
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">

                                    <i class="bi bi-hdd-network"></i>

                                </span>

                                <select class="form-select form-select-lg"
                                        name="TipoActivo"
                                        required>

                                    <option value="">
                                        Seleccione un tipo...
                                    </option>

                                    <option value="@TipoActivo.PC">
                                        PC
                                    </option>

                                    <option value="@TipoActivo.MOVIL">
                                        Móvil
                                    </option>

                                    <option value="@TipoActivo.SERVER">
                                        Servidor
                                    </option>

                                </select>

                            </div>

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Criticidad
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">

                                    <i class="bi bi-exclamation-triangle"></i>

                                </span>

                                <input type="number"
                                       class="form-control form-control-lg"
                                       name="Criticidad"
                                       min="1"
                                       max="5"
                                       placeholder="1 - 5"
                                       required />

                            </div>

                        </div>

                        <div class="form-check form-switch mb-4">

                            <input class="form-check-input"
                                   type="checkbox"
                                   name="Backup"
                                   id="Backup" />

                            <label class="form-check-label"
                                   for="Backup">

                                Posee Backup

                            </label>

                        </div>

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Listar"
                               asp-route-codigoCuenta="@Model.CodigoAutoincremental"
                               class="btn btn-outline-secondary">

                                <i class="bi bi-arrow-left me-1"></i>

                                Cancelar

                            </a>

                            <button type="submit"
                                    class="btn btn-success">

                                <i class="bi bi-floppy me-1"></i>

                                Guardar Activo

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>