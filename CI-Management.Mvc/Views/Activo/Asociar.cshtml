@using dominio
@model Cuenta

@if (ViewBag.MensajeExito != null)
{

    <div class="alert alert-success" role="alert">
        @ViewBag.MensajeExito
    </div>
}
@if (ViewBag.MensajeError != null)
{

    <div class="alert alert-danger" role="alert">
        @ViewBag.MensajeError
    </div>
}
<div class="container mt-5">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Asociar Activo a cuenta @Model.CodigoAutoincremental de @Model.Titular.Nombre</h3>
        </div>

        <div class="card-body">

            <form action="/Activo/Asociar" method="post">

                <input type="hidden"
                       name="codigoCuenta"
                       value="@ViewBag.cuenta" />

                <div class="mb-3">
                    <label class="form-label">Nombre</label>
                    <input type="text"
                           class="form-control"
                           name="Nombre"
                           required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Tipo de Activo</label>

                    <select class="form-select" name="TipoActivo" required>
                        <option value="">Seleccione un tipo...</option>
                        <option value="@TipoActivo.PC">PC</option>
                        <option value="@TipoActivo.MOVIL">MOVIL</option>
                        <option value="@TipoActivo.SERVER">SERVER</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Criticidad</label>

                    <input type="number"
                           class="form-control"
                           name="Criticidad"
                           min="1"
                           max="5"
                           required />
                </div>

                <div class="form-check mb-4">
                    <input class="form-check-input"
                           type="checkbox"
                           name="Backup"
                           id="Backup" />

                    <label class="form-check-label" for="Backup">
                        Posee Backup
                    </label>
                </div>

                <div class="d-flex justify-content-end">

                    <button type="submit" class="btn btn-success me-2">
                        Guardar
                    </button>

                    <a asp-action="Listar" asp-route-codigoCuenta="@Model.CodigoAutoincremental" class="btn btn-secondary">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>