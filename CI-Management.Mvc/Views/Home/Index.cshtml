@{
    ViewData["Title"] = "Home Page";
}

<div class="container py-5">

    <!-- HERO -->

    <div class="row align-items-center min-vh-50">

        <div class="col-lg-6">

            <span class="badge bg-primary mb-3 px-3 py-2">
                Plataforma de Ciberseguridad
            </span>

            <h1 class="display-3 fw-bold mb-4">
                Cyber Incident <br>
                Management System
            </h1>

            <p class="lead text-secondary mb-4">
                Plataforma centralizada para gestionar incidentes de ciberseguridad,
                activos tecnológicos, cuentas de usuario y evaluación de riesgos
                dentro de una organización.
            </p>

            <div class="d-flex gap-3 flex-wrap">

                <a asp-controller="Login"
                   asp-action="Index"
                   class="btn btn-primary btn-lg">

                    <i class="bi bi-box-arrow-in-right me-2"></i>
                    Iniciar Sesión

                </a>

                <a asp-controller="Register"
                   asp-action="Index"
                   class="btn btn-outline-primary btn-lg">

                    <i class="bi bi-person-plus me-2"></i>
                    Registrarse

                </a>

            </div>

        </div>

        <div class="col-lg-6 text-center mt-5 mt-lg-0">

            <i class="bi bi-shield-lock-fill text-primary"
               style="font-size: 12rem;"></i>

        </div>

    </div>

    <!-- FEATURES -->

    <section class="py-5">

        <div class="text-center mb-5">

            <h2 class="fw-bold">
                Funcionalidades Principales
            </h2>

            <p class="text-secondary">
                Todo lo necesario para gestionar la seguridad de una organización.
            </p>

        </div>

        <div class="row g-4">

            <div class="col-md-6 col-xl-3">

                <div class="card shadow-sm h-100">

                    <div class="card-body text-center p-4">

                        <i class="bi bi-shield-exclamation text-danger display-5"></i>

                        <h5 class="mt-3 fw-semibold">
                            Gestión de Incidentes
                        </h5>

                        <p class="text-secondary">
                            Registrar y monitorear incidentes de Phishing y Ransomware.
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-md-6 col-xl-3">

                <div class="card shadow-sm h-100">

                    <div class="card-body text-center p-4">

                        <i class="bi bi-pc-display text-primary display-5"></i>

                        <h5 class="mt-3 fw-semibold">
                            Gestión de Activos
                        </h5>

                        <p class="text-secondary">
                            Administrar activos tecnológicos, criticidad y estado de respaldos.
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-md-6 col-xl-3">

                <div class="card shadow-sm h-100">

                    <div class="card-body text-center p-4">

                        <i class="bi bi-people-fill text-success display-5"></i>

                        <h5 class="mt-3 fw-semibold">
                            Gestión de Usuarios
                        </h5>

                        <p class="text-secondary">
                            Administrar usuarios, permisos y cuentas dentro de la organización.
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-md-6 col-xl-3">

                <div class="card shadow-sm h-100">

                    <div class="card-body text-center p-4">

                        <i class="bi bi-graph-up-arrow text-warning display-5"></i>

                        <h5 class="mt-3 fw-semibold">
                            Evaluación de Riesgos
                        </h5>

                        <p class="text-secondary">
                            Analizar la severidad de incidentes mediante reglas de negocio.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- TECNOLOGÍAS -->

    <section class="py-5">

        <div class="text-center">

            <h2 class="fw-bold mb-4">
                Tecnologías Utilizadas
            </h2>

            <div class="d-flex justify-content-center flex-wrap gap-2">

                <span class="badge bg-primary p-2 px-3">C#</span>
                <span class="badge bg-secondary p-2 px-3">ASP.NET MVC</span>
                <span class="badge bg-dark p-2 px-3">GitHub</span>
                <span class="badge bg-success p-2 px-3">Azure</span>
                <span class="badge bg-info p-2 px-3">Bootstrap</span>

            </div>

        </div>

    </section>

    <!-- CTA -->

    <section class="py-5">

        <div class="card border-0 shadow-sm">

            <div class="card-body text-center p-5">

                <h2 class="fw-bold mb-3">
                    ¿Querés conocer más sobre el proyecto?
                </h2>

                <p class="text-secondary mb-4">
                    Contactos
                </p>

                <a href="https://github.com/MateoFinno/Cyber-Incident-Management-System"
                   target="_blank"
                   class="btn btn-dark btn-lg me-2">

                    <i class="bi bi-github me-2"></i>
                    GitHub

                </a>

                <a href="https://www.linkedin.com/in/mateofinno/"
                   target="_blank"
                   class="btn btn-primary btn-lg">

                    <i class="bi bi-linkedin me"></i>
                </a>

            </div>

        </div>

    </section>

</div>