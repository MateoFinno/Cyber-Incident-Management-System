@model List<dominio.Incidente>

<div class="container py-5">

    <div class="card shadow-lg border-0 table-card">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>

                    <h2 class="fw-bold mb-1">

                        <i class="bi bi-shield-exclamation text-danger me-2"></i>

                        Centro de Incidentes

                    </h2>

                    <p class="text-secondary mb-0">
                        Monitor y seguimiento de incidentes de ciberseguridad registrados.
                    </p>

                </div>

                @if (Model != null)
                {
                    <span class="badge bg-danger fs-6 px-3 py-2">
                        @Model.Count Incidentes
                    </span>
                }

            </div>

            @if (Model != null && Model.Count > 0)
            {

                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>

                            <tr>
                                <th>ID</th>
                                <th>Fecha</th>
                                <th>Estado</th>
                                <th>Activo Afectado</th>
                                <th>Severidad</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var i in Model)
                            {
                                int severidad = i.CalcularSeveridad();

                                <tr>

                                    <td>

                                        <span class="fw-semibold">
                                            #@i.IdAutonumerico
                                        </span>

                                    </td>

                                    <td>
                                        @i.FechaDeReporte.ToShortDateString()
                                    </td>

                                    <td>

                                        <span class="badge bg-info text-dark">

                                            @i.Estado

                                        </span>

                                    </td>

                                    <td>

                                        <span class="badge bg-secondary">

                                            Activo #@i.ActivoAfectado.CodigoAutoincremental

                                        </span>

                                    </td>

                                    <td>

                                        @if (severidad >= 80)
                                        {
                                            <span class="badge bg-danger px-3 py-2">

                                                🔴 Crítica (@severidad)

                                            </span>
                                        }
                                        else if (severidad >= 50)
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-2">

                                                🟠 Alta (@severidad)

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success px-3 py-2">

                                                🟢 Baja (@severidad)

                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            }
            else
            {

                <div class="text-center py-5">

                    <i class="bi bi-shield-check text-success"
                       style="font-size:4rem"></i>

                    <h4 class="mt-3">
                        No hay incidentes registrados
                    </h4>

                    <p class="text-secondary">
                        El sistema no reporta incidentes activos actualmente.
                    </p>

                </div>

            }

        </div>

    </div>

</div>
