@using dominio
@model List<Cuenta>


<div class="container mt-5">

		<div class="card shadow">

			<div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
				<h3 class="mb-0">Listado de Cuentas</h3>
				<form action ="/Cuentas/CrearCuenta" method="post">
				<input type="hidden" name="cedulaTitular" value="@ViewBag.Cedula" />
				<button class="btn btn-light" type="submit">
					Crear Cuenta
				</button>
			</form>
			</div>

			<div class="card-body">

				<div class="table-responsive">

					<table class="table table-hover table-striped align-middle">

						<thead class="table-dark">
							<tr>
								<th>Código</th>
								<th>Fecha Cambio Contraseña</th>
								<th>MultiFactor</th>
								<th class="text-center">Acciones</th>
							</tr>
						</thead>

						<tbody>

						@foreach (Cuenta cuenta in Model)
						{
							<tr>
								<td>@cuenta.CodigoAutoincremental</td>

								<td>
									@cuenta.FechaCambioPass.ToString("dd/MM/yyyy")
								</td>

								<td>
									@if (cuenta.MultiFactor)
									{
										<span class="badge bg-success">
											Activado
										</span>
									}
									else
									{
										<span class="badge bg-danger">
											Desactivado
										</span>
									}
								</td>

								<td class="text-center">
									<a asp-controller="Activo"
									asp-action="Listar"
									asp-route-codigoCuenta="@cuenta.CodigoAutoincremental"
									class="btn btn-primary btn-sm">
										Activos
									</a>
								</td>
							</tr>

						}
						</tbody>

					</table>

				</div>

			</div>

		</div>
	

</div>